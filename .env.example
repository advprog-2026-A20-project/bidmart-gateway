PORT=8080
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:5432/<database>
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>
JWT_SECRET=<jwt-secret-at-least-32-chars>
JWT_EXP_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://<your-vercel-domain>
AUCTION_QUERY_SERVICE_ENABLED=false
AUCTION_QUERY_SERVICE_BASE_URL=http://localhost:8081
AUCTION_QUERY_SERVICE_ROLLOUT_MODE=DISABLED
LISTING_QUERY_SERVICE_ENABLED=false
LISTING_QUERY_SERVICE_BASE_URL=http://localhost:8082
LISTING_QUERY_SERVICE_ROLLOUT_MODE=DISABLED
