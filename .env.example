PORT=8080
JWT_SECRET=<jwt-secret-at-least-32-chars>
JWT_EXP_SECONDS=604800
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://bidmart.vercel.app
AUTH_SERVICE_ENABLED=true
AUTH_SERVICE_BASE_URL=https://<your-auth-service>.herokuapp.com
WALLET_SERVICE_ENABLED=true
WALLET_SERVICE_BASE_URL=https://<your-wallet-service>.herokuapp.com
BIDDING_COMMAND_SERVICE_ENABLED=true
BIDDING_COMMAND_SERVICE_BASE_URL=https://<your-bidding-command-service>.herokuapp.com
AUCTION_QUERY_SERVICE_ENABLED=true
AUCTION_QUERY_SERVICE_BASE_URL=https://<your-auction-query-service>.herokuapp.com
AUCTION_QUERY_SERVICE_ROLLOUT_MODE=FULL
LISTING_QUERY_SERVICE_ENABLED=true
LISTING_QUERY_SERVICE_BASE_URL=https://<your-listing-query-service>.herokuapp.com
LISTING_QUERY_SERVICE_ROLLOUT_MODE=FULL
